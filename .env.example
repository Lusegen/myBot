# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID врача: получает админ-панель и уведомления о новых записях (обязательно)
ADMIN_ID=

# Файл БД с расписанием (создаётся автоматически)
DB_NAME=bot_schedule.db

# Файл БД с настройками и текстами (создаётся автоматически)
SETTINGS_DB_NAME=bot_database.db

# Длительность консультации в чате, часы
CONSULTATION_SESSION_DURATION=24
